---
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getBacklinks } from '../lib/wikigraph.mjs';
import { SITE_TITLE, SITE_LANG } from '../consts';
import '../styles/global.css';

const { book, chapters, current, prev, next } = Astro.props;

const groups = [];
for (const ch of chapters) {
  const p = ch.data.part || '';
  let g = groups.find((x) => x.name === p);
  if (!g) { g = { name: p, items: [] }; groups.push(g); }
  g.items.push(ch);
}
const currentData = current.data;
const backlinks = getBacklinks(`/books/${current.id}/`);
---

<html lang={SITE_LANG}>
  <head>
    <BaseHead title={`${currentData.title} · ${book.title}`} description={book.description ?? book.title} />
  </head>
  <body class="reader-body">
    <div class="mobile-bar">
      <a href="/" class="m-site">{SITE_TITLE}</a>
      <div class="m-actions">
        <a href="/search" class="m-search" aria-label="검색">검색</a>
        <button class="toc-toggle" type="button" aria-label="목차 열기"
          onclick="document.querySelector('.toc').classList.toggle('open')">목차</button>
        <ThemeToggle />
      </div>
    </div>

    <div class="reader">
      <aside class="toc">
        <div class="side-top">
          <a href="/" class="site">{SITE_TITLE}</a>
          <ThemeToggle />
        </div>
        <div class="side-links">
          <a href="/books" class="back">← 서재</a>
          <a href="/search" class="back">검색</a>
        </div>
        <div class="book-head">
          <div class="book-title">{book.title}</div>
          {book.author && <div class="book-author">{book.author}</div>}
        </div>
        <nav class="toc-nav">
          {groups.map((g) => (
            <div class="part">
              {g.name && <div class="part-name">{g.name}</div>}
              <ul>
                {g.items.map((ch) => (
                  <li>
                    <a
                      href={`/books/${ch.id}/`}
                      class:list={['toc-link', { active: ch.id === current.id }]}
                    >{ch.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <main class="content">
        <article>
          <div class="ch-part">{currentData.part || book.title}</div>
          <h1>{currentData.title}</h1>
          <div class="ch-body">
            <slot />
          </div>

          <nav class="pager">
            {prev ? (
              <a class="pg prev" href={`/books/${prev.id}/`}>
                <span class="dir">← 이전</span>
                <span class="t">{prev.data.title}</span>
              </a>
            ) : <span />}
            {next ? (
              <a class="pg next" href={`/books/${next.id}/`}>
                <span class="dir">다음 →</span>
                <span class="t">{next.data.title}</span>
              </a>
            ) : <span />}
          </nav>

          {backlinks.length > 0 && (
            <aside class="backlinks">
              <div class="bl-title">이 글을 언급한 글</div>
              <ul>
                {backlinks.map((b) => (
                  <li><a href={b.url}>{b.title}</a></li>
                ))}
              </ul>
            </aside>
          )}
        </article>
      </main>
    </div>
  </body>
</html>

<style>
  .reader-body { margin: 0; }
  .reader { display: grid; grid-template-columns: 300px minmax(0, 1fr); align-items: start; }

  .toc {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 1.4rem 1.4rem 2rem;
    border-right: 1px solid rgb(var(--gray-light));
    box-sizing: border-box;
  }
  .side-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .side-top .site {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: rgb(var(--black));
    text-decoration: none;
  }
  .side-links { display: flex; gap: 1rem; margin-bottom: 1.2rem; }
  .back { font-size: 0.85rem; color: rgb(var(--gray)); text-decoration: none; }
  .back:hover { color: var(--accent); }
  .book-head { margin-bottom: 1.2rem; }
  .book-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.3rem;
    color: rgb(var(--black));
    line-height: 1.3;
  }
  .book-author { font-size: 0.85rem; color: rgb(var(--gray)); margin-top: 0.3rem; }

  .toc-nav .part { margin-bottom: 1.1rem; }
  .part-name {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: rgb(var(--gray));
    margin: 0.6rem 0 0.4rem;
  }
  .toc-nav ul { list-style: none; margin: 0; padding: 0; }
  .toc-nav li { margin: 0; }
  .toc-link {
    display: block;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.92rem;
    color: rgb(var(--gray-dark));
    text-decoration: none;
    line-height: 1.5;
  }
  .toc-link:hover { background: rgba(var(--gray), 0.12); color: rgb(var(--black)); }
  .toc-link.active { background: var(--accent); color: #fff; font-weight: 500; }

  .content { padding: 3rem 2rem 4rem; }
  .content article { max-width: 880px; margin: 0 auto; }
  .ch-part {
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }
  .content h1 { font-size: 2rem; margin-bottom: 1.5rem; }
  .ch-body { font-size: 1.05rem; line-height: 1.95; }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--gray-light));
  }
  .pg { display: flex; flex-direction: column; gap: 3px; text-decoration: none; max-width: 48%; }
  .pg.next { text-align: right; margin-left: auto; }
  .pg .dir { font-size: 0.8rem; color: rgb(var(--gray)); }
  .pg .t { color: var(--accent); font-weight: 500; font-family: var(--font-serif); }
  .pg:hover .t { color: var(--accent-dark); }

  .backlinks {
    margin-top: 2.5rem;
    padding: 1.2rem 1.4rem;
    background: rgba(var(--gray), 0.07);
    border-radius: 10px;
    max-width: 40em;
  }
  .bl-title { font-size: 0.85rem; color: rgb(var(--gray)); margin-bottom: 0.6rem; }
  .backlinks ul { list-style: none; margin: 0; padding: 0; }
  .backlinks li { margin: 0.2rem 0; }
  .backlinks a { font-family: var(--font-serif); color: var(--accent); text-decoration: none; }
  .backlinks a:hover { color: var(--accent-dark); }

  .mobile-bar { display: none; }
  .toc-toggle {
    background: none;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 8px;
    height: 36px;
    padding: 0 12px;
    font-size: 0.9rem;
    color: rgb(var(--gray-dark));
    cursor: pointer;
    font-family: var(--font-sans);
  }
  .m-search { font-size: 0.9rem; color: rgb(var(--gray-dark)); text-decoration: none; }

  @media (max-width: 820px) {
    .reader { display: block; }
    .mobile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid rgb(var(--gray-light));
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 10;
    }
    .m-site { font-family: var(--font-serif); font-weight: 600; color: rgb(var(--black)); text-decoration: none; }
    .m-actions { display: flex; align-items: center; gap: 10px; }
    .toc {
      display: none;
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid rgb(var(--gray-light));
    }
    .toc.open { display: block; }
    .toc .side-top { display: none; }
    .content { padding: 1.8rem 1.2rem 3rem; }
    .content h1 { font-size: 1.7rem; }
  }
</style>
