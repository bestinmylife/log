---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a href="/" class="site-title">{SITE_TITLE}</a>
    <div class="links">
      <HeaderLink href="/">홈</HeaderLink>
      <HeaderLink href="/books">서재</HeaderLink>
      <HeaderLink href="/blog">일지</HeaderLink>
      <HeaderLink href="/search">검색</HeaderLink>
      <HeaderLink href="/about">소개</HeaderLink>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--bg);
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 720px;
    margin: 0 auto;
    height: 64px;
  }
  .site-title {
    font-family: var(--font-serif);
    font-weight: 600;
    text-decoration: none;
    color: rgb(var(--black));
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  .links { display: flex; align-items: center; gap: 0.85em; }
</style>
